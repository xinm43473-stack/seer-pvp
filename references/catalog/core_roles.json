{
  "schema_version": 2.0,
  "generated_at": "2026-11-06",
  "purpose": "核心定位唯一口径源：一级 6 大类（配队骨架，可多标签）＋二级特色机制位（最突出、最能与同类区分的结算特色）；宽泛到什么精灵都能填的功能位不算定位。",
  "rule": [
    "每只深研精灵只写 1-2 个最突出、最能与同类区分的特色机制位，宁少勿滥；机制碎片、体系名、BP 池归属、月榜标签一律不作定位。",
    "定位必须来自 core_roles 词表；2026-11-06 用户纠正：如果什么精灵都能填、还不是很突出，就等于没有定位。",
    "相似定位组只由「共享同一个可辨识结算机制」的 2-3 只构成，禁止按泛功能位或能力清单凑组。",
    "同一只精灵最多属于一个相似定位组，且该组必须匹配其第 1 个特色定位；没有同类就不建组，直接写「暂无已核实关联」。",
    "2026-11-06 用户补充：一级定位先按 6 大类（主力／突破手／拦截／辅助／干扰／特殊）分，允许一只精灵有 1-3 个类标签（部分精灵多定位）；二级特色机制位保持不变。"
  ],
  "core_roles": {
    "弹伤反制": "把受到的攻击／致死伤害等量或按比例转成伤害还给对手（机盖式弹真伤、武道逆转轨迹反弹）",
    "暴击针对": "免疫、抵挡或反弹致命一击（暴击），专门拆对手的暴击斩杀线",
    "高红压制": "攻击伤害（红伤）增幅、无视强化、破防输出，靠红伤数值压血线",
    "消强联防": "登场／回合开始消强、双消、断回合，专治强化成型",
    "护盾联防": "护盾／护罩承伤，护盾存在或被击破时触发收益",
    "闪避联防": "闪避、魂免、免控，让对手攻击直接落空",
    "阵亡先制": "按己方／对手阵亡数叠先制，靠后场进场拿收割窗口",
    "清PP压制": "让对手技能 PP 归零或剧减，制造 PP 差",
    "封属干扰": "封属、沉默、封回血、锁切，掐掉对手属性线",
    "异常挂载": "主动挂烧伤／中毒／寄生／焚烬并引爆",
    "阵亡传承": "死亡／下场时把资源交给下 1 只出战精灵",
    "印记体系轴": "链接／同步／印记／星赐等体系资源，供全队或下一棒兑现",
    "控场": "睡眠／害怕／冰封／瘫痪／束缚，限制对手行动",
    "续航壁垒": "回血、锁伤、免秒杀、保留 1 点体力，靠存活能力占场",
    "团队增益": "给全队／队友 buff、保护、复活、回血",
    "联攻核心": "发起团队联攻，收益由全队共同兑现",
